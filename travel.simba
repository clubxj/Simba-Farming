{$INCLUDE_ONCE WaspLib/osrs.simba}
{$INCLUDE_ONCE chunks.simba}

type
  ERSFarmTravelType = enum(
    ITEM,
    MAGIC,
    POH_PORTAL,
    POH_NEXUS,
    POH_SPIRIT_TREE,
    POH_FAIRY_RING,
    CONFIRM
  );

  // Reqs: AND of OR-groups. Each inner array is alternatives; all groups must be met.
  // Loaded for future GUI validation — travel runtime does not check them.
  TRSFarmTravelReqs = array of TStringArray;

  // Teleport landing jitter: center + radius (world/global coords).
  TRSFarmTravelLanding = record
    X: Integer;
    Y: Integer;
    Radius: Integer;
  end;

  TRSFarmTravelMethod = record
    Id: String;
    TravelType: ERSFarmTravelType;
    ChunkId: String;
    Landing: TRSFarmTravelLanding;
    Item: TRSItem;
    Option: String;
    SpellName: String;
    Reqs: TRSFarmTravelReqs;
  end;

  TRSFarmingTravel = record
    Loaded: Boolean;
    DataPath: String;
    Methods: array of TRSFarmTravelMethod;
  end;

var FarmingTravel: TRSFarmingTravel;

function ERSFarmTravelType.FromString(value: String): ERSFarmTravelType; static;
begin
  case value.ToLower() of
    'item':            Exit(ERSFarmTravelType.ITEM);
    'magic':           Exit(ERSFarmTravelType.MAGIC);
    'poh_portal':      Exit(ERSFarmTravelType.POH_PORTAL);
    'poh_nexus':       Exit(ERSFarmTravelType.POH_NEXUS);
    'poh_spirit_tree': Exit(ERSFarmTravelType.POH_SPIRIT_TREE);
    'poh_fairy_ring':  Exit(ERSFarmTravelType.POH_FAIRY_RING);
    'confirm':         Exit(ERSFarmTravelType.CONFIRM);
  else
    raise Format('Unknown travel type "%s"', [value]);
  end;
end;

function TRSFarmingTravel.LandingFromJSON(item: TJSONItem): TRSFarmTravelLanding; static;
begin
  if (item.Typ <> EJSONType.ARR) or (item.Count <> 3) then
    raise 'Expected landing [x, y, radius]';

  Result.X := item.Item[0].AsInt;
  Result.Y := item.Item[1].AsInt;
  Result.Radius := item.Item[2].AsInt;
  if Result.Radius <= 0 then
    raise 'Landing radius must be > 0';
end;

function TRSFarmingTravel.StringArrayFromJSON(item: TJSONItem): TStringArray; static;
var
  i: Integer;
begin
  if item.Typ <> EJSONType.ARR then
    raise 'Expected JSON array of strings';

  SetLength(Result, item.Count);
  for i := 0 to item.Count - 1 do
    Result[i] := item.Item[i].AsString;
end;

function TRSFarmingTravel.ReqsFromJSON(item: TJSONItem): TRSFarmTravelReqs; static;
var
  i: Integer;
begin
  if item.Typ <> EJSONType.ARR then
    raise 'travel.json reqs must be an array of string arrays';

  SetLength(Result, item.Count);
  for i := 0 to item.Count - 1 do
  begin
    if item.Item[i].Typ <> EJSONType.ARR then
      raise 'travel.json reqs groups must be arrays of item name strings';
    Result[i] := Self.StringArrayFromJSON(item.Item[i]);
  end;
end;

function TRSFarmingTravel.JSONHas(item: TJSONItem; key: String): Boolean; static;
begin
  try
    Result := item.Item[key].Typ <> EJSONType.UNKNOWN;
  except
    Result := False;
  end;
end;

function TRSFarmingTravel.ResolveDataPath(path: String): String;
var
  candidate: String;
  candidates: TStringArray;
begin
  if path <> '' then
  begin
    if not FileExists(path) then
      raise Format('Travel data file not found: %s', [path]);
    Exit(path);
  end;

  candidates := [
    IncludePath + 'data/travel.json',
    IncludePath + '../data/travel.json',
    './data/travel.json',
    'data/travel.json'
  ];

  for candidate in candidates do
    if FileExists(candidate) then
      Exit(candidate);

  raise 'travel.json not found. Pass an absolute path to FarmingTravel.Init()';
end;

function TRSFarmingTravel.HasMethod(methodId: String): Boolean;
var
  method: TRSFarmTravelMethod;
begin
  for method in Self.Methods do
    if method.Id = methodId then
      Exit(True);
end;

function TRSFarmingTravel.FindMethod(methodId: String): TRSFarmTravelMethod;
var
  method: TRSFarmTravelMethod;
begin
  for method in Self.Methods do
    if method.Id = methodId then
      Exit(method);

  raise Format('Unknown travel method "%s"', [methodId]);
end;

function TRSFarmingTravel.SpellFromName(spellName: String): ERSSpell;
var
  spell: ERSSpell;
  needle: String;
begin
  needle := spellName.ToUpper().Replace(' ', '_');
  for spell in ERSSpell do
    if ToStr(spell).After('ERSSpell.') = needle then
      Exit(spell);

  raise Format('Unknown spell "%s" in travel.json', [spellName]);
end;

function TRSFarmingTravel.InLanding(landing: TRSFarmTravelLanding): Boolean;
var
  pos: TPoint;
  dx, dy: Integer;
begin
  pos := Map.Position;
  dx := pos.X - landing.X;
  dy := pos.Y - landing.Y;
  Result := Sqrt(Sqr(dx) + Sqr(dy)) <= landing.Radius;
end;

function TRSFarmingTravel.ConfirmLanding(landing: TRSFarmTravelLanding; timeout: Integer = 3000): Boolean;
begin
  Result := SleepUntil(Self.InLanding(landing), Random(100, 600), timeout);
end;

function TRSFarmingTravel.TryItemOnInterface(method: TRSFarmTravelMethod; items: TRSItemInterface; slots: TRSSlotInterface; attempts: Integer): Boolean;
var
  attempt, slot: Integer;
begin
  for attempt := 1 to attempts do
    if items.Find(method.Item, slot) then
    begin
      slots.Hover(slot);
      Sleep(75);
      if MainScreen.IsUpText(method.Option) then
      begin
        Mouse.Click(EMouseButton.LEFT);
        Exit(Self.ConfirmLanding(method.Landing));
      end else if ChooseOption.Open then
      begin
        if ChooseOption.Find([method.Option], False, False) then
          Exit(ChooseOption.Select(method.Option, False, True) and Self.ConfirmLanding(method.Landing))
        else if ChooseOption.OpenSubmenu(True) then
          Exit(ChooseOption.SelectSubmenuOption([method.Option], False, True) and Self.ConfirmLanding(method.Landing));
      end;
    end;
end;

function TRSFarmingTravel.ItemTeleport(method: TRSFarmTravelMethod; attempts: Integer): Boolean;
begin
  if Inventory.IsOpen then
  begin
    if Self.TryItemOnInterface(method, Inventory.Items, Inventory.Slots, attempts) then
      Exit(True);
  end else if Equipment.IsOpen then
  begin
    if Self.TryItemOnInterface(method, Equipment.Items, Equipment.Slots, attempts) then
      Exit(True);
  end else if Inventory.Open then
  begin
    if Self.TryItemOnInterface(method, Inventory.Items, Inventory.Slots, attempts) then
      Exit(True);
  end else if Equipment.Open then
  begin
    if Self.TryItemOnInterface(method, Equipment.Items, Equipment.Slots, attempts) then
      Exit(True);
  end else
    Exit;

  if Inventory.IsOpen and Equipment.Open then
    Exit(Self.TryItemOnInterface(method, Equipment.Items, Equipment.Slots, attempts));

  if Equipment.IsOpen and Inventory.Open then
    Exit(Self.TryItemOnInterface(method, Inventory.Items, Inventory.Slots, attempts));
end;

function TRSFarmingTravel.MagicTeleport(method: TRSFarmTravelMethod; attempts: Integer): Boolean;
var
  attempt: Integer;
  spell: ERSSpell;
begin
  spell := Self.SpellFromName(method.SpellName);

  for attempt := 1 to attempts do
  begin
    if (Magic.GetSpellBook = ERSSpellBook.LUNAR) and not (spell in RS_LUNAR_SPELLS) then
      if not (Magic.CastSpell(ERSSpell.SPELLBOOK_SWAP) and SleepUntil((Magic.GetSpellBook <> ERSSpellBook.LUNAR), Random(100, 800), 3000)) then
        Continue;

    if Magic.CastSpell(spell, method.Option) and Self.ConfirmLanding(method.Landing, 2400) then
      Exit(True);
  end;
end;

function TRSFarmingTravel.POHPortal(method: TRSFarmTravelMethod; attempts: Integer): Boolean;
begin
  Result := False;
  raise Format('POH portal travel is not implemented yet (%s -> %s)', [method.Id, method.ChunkId]);
end;

function TRSFarmingTravel.POHNexus(method: TRSFarmTravelMethod; attempts: Integer): Boolean;
begin
  Result := False;
  raise Format('POH nexus travel is not implemented yet (%s -> %s)', [method.Id, method.ChunkId]);
end;

function TRSFarmingTravel.POHSpiritTree(method: TRSFarmTravelMethod; attempts: Integer): Boolean;
begin
  Result := False;
  raise Format('POH spirit tree travel is not implemented yet (%s -> %s)', [method.Id, method.ChunkId]);
end;

function TRSFarmingTravel.POHFairyRing(method: TRSFarmTravelMethod; attempts: Integer): Boolean;
begin
  Result := False;
  raise Format('POH fairy ring travel is not implemented yet (%s -> %s)', [method.Id, method.ChunkId]);
end;

function TRSFarmingTravel.ConfirmOnly(method: TRSFarmTravelMethod; attempts: Integer): Boolean;
begin
  Result := FarmingChunks.ContainsPlayer(method.ChunkId);
end;

function TRSFarmingTravel.ExecuteMethod(method: TRSFarmTravelMethod; attempts: Integer): Boolean;
begin
  case method.TravelType of
    ERSFarmTravelType.ITEM:            Exit(Self.ItemTeleport(method, attempts));
    ERSFarmTravelType.MAGIC:           Exit(Self.MagicTeleport(method, attempts));
    ERSFarmTravelType.POH_PORTAL:      Exit(Self.POHPortal(method, attempts));
    ERSFarmTravelType.POH_NEXUS:       Exit(Self.POHNexus(method, attempts));
    ERSFarmTravelType.POH_SPIRIT_TREE: Exit(Self.POHSpiritTree(method, attempts));
    ERSFarmTravelType.POH_FAIRY_RING:  Exit(Self.POHFairyRing(method, attempts));
    ERSFarmTravelType.CONFIRM:         Exit(Self.ConfirmOnly(method, attempts));
  end;
end;

// Called by the farm run handler with the chosen transport method id.
// Loads chunks, skips teleport when already in the chunk area, otherwise teleports and
// confirms landing. Does not walk to the patch — WalkFind owns that.
function TRSFarmingTravel.Travel(methodId: String; attempts: Integer = 2): Boolean;
var
  method: TRSFarmTravelMethod;
begin
  if not Self.Loaded then
    raise 'FarmingTravel.Init() must be called before Travel()';

  method := Self.FindMethod(methodId);
  FarmingChunks.LoadMap(method.ChunkId);

  if FarmingChunks.ContainsPlayer(method.ChunkId) then
  begin
    WriteLn(Format('%s:[FarmingTravel]: already in chunk=%s (skip %s)', [
      GetTimeStamp(), method.ChunkId, method.Id
    ]));
    Exit(True);
  end;

  WriteLn(Format('%s:[FarmingTravel]: method=%s type=%s chunk=%s landing=(%d,%d)r=%d', [
    GetTimeStamp(),
    method.Id,
    ToStr(method.TravelType),
    method.ChunkId,
    method.Landing.X,
    method.Landing.Y,
    method.Landing.Radius
  ]));

  Result := Self.ExecuteMethod(method, attempts);
end;

procedure TRSFarmingTravel.ParseMethods(root: TJSONItem);
var
  methods: TJSONItem;
  node: TJSONItem;
  i: Integer;
  method: TRSFarmTravelMethod;
begin
  methods := root.Item['methods'];
  if methods.Typ <> EJSONType.ARR then
    raise 'travel.json methods must be an array';

  SetLength(Self.Methods, methods.Count);
  for i := 0 to methods.Count - 1 do
  begin
    node := methods.Item[i];
    method.Id := node.Item['id'].AsString;
    method.TravelType := ERSFarmTravelType.FromString(node.Item['type'].AsString);
    method.ChunkId := node.Item['chunk'].AsString;
    method.Landing := Self.LandingFromJSON(node.Item['landing']);
    method.Item := '';
    method.Option := '';
    method.SpellName := '';
    method.Reqs := [];

    if Self.JSONHas(node, 'item') then
      method.Item := node.Item['item'].AsString;
    if Self.JSONHas(node, 'option') then
      method.Option := node.Item['option'].AsString;
    if Self.JSONHas(node, 'spell') then
      method.SpellName := node.Item['spell'].AsString;
    if Self.JSONHas(node, 'reqs') then
      method.Reqs := Self.ReqsFromJSON(node.Item['reqs']);

    case method.TravelType of
      ERSFarmTravelType.ITEM:
        if (method.Item = '') or (method.Option = '') then
          raise Format('Method "%s" requires item + option', [method.Id]);
      ERSFarmTravelType.MAGIC:
        if method.SpellName = '' then
          raise Format('Method "%s" requires spell', [method.Id]);
    end;

    if not FarmingChunks.Has(method.ChunkId) then
      raise Format('Method "%s" references unknown chunk "%s"', [method.Id, method.ChunkId]);

    Self.Methods[i] := method;
  end;
end;

procedure TRSFarmingTravel.Load(path: String = '');
var
  parser: TJSONParser;
begin
  if not FarmingChunks.Loaded then
    raise 'FarmingChunks.Init() must be called before FarmingTravel.Load()';

  Self.DataPath := Self.ResolveDataPath(path);
  parser := new TJSONParser();
  parser.Load(Self.DataPath);
  Self.ParseMethods(parser);
  Self.Loaded := True;

  WriteLn(Format('%s:[FarmingTravel]: loaded %s (%d methods)', [
    GetTimeStamp(),
    Self.DataPath,
    Length(Self.Methods)
  ]));
end;

procedure TRSFarmingTravel.Init(path: String = '');
begin
  if not FarmingChunks.Loaded then
    FarmingChunks.Init();
  Self.Load(path);
end;
