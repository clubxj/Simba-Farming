{$INCLUDE_ONCE WaspLib/osrs.simba}

type
  ERSFarmTravelType = enum(
    ITEM,
    MAGIC,
    POH_PORTAL,
    POH_NEXUS,
    POH_SPIRIT_TREE,
    CONFIRM
  );

  TRSFarmTravelDestination = record
    Id: String;
    MapArea: TBox;
  end;

  TRSFarmTravelMethod = record
    Id: String;
    TravelType: ERSFarmTravelType;
    DestinationId: String;
    Item: TRSItem;
    Option: String;
    SpellName: String;
  end;

  TRSFarmTravelPatchRoute = record
    PatchId: String;
    DestinationId: String;
    MethodIds: TStringArray;
  end;

  TRSFarmingTravel = record
    Loaded: Boolean;
    DataPath: String;
    Destinations: array of TRSFarmTravelDestination;
    Methods: array of TRSFarmTravelMethod;
    Patches: array of TRSFarmTravelPatchRoute;
  end;

var FarmingTravel: TRSFarmingTravel;

function ERSFarmTravelType.FromString(value: String): ERSFarmTravelType; static;
begin
  case value.ToLower() of
    'item':            Exit(ERSFarmTravelType.ITEM);
    'magic':           Exit(ERSFarmTravelType.MAGIC);
    'poh_portal':      Exit(ERSFarmTravelType.POH_PORTAL);
    'poh_nexus':       Exit(ERSFarmTravelType.POH_NEXUS);
    'poh_spirit_tree': Exit(ERSFarmTravelType.POH_SPIRIT_TREE);
    'confirm':         Exit(ERSFarmTravelType.CONFIRM);
  else
    raise Format('Unknown travel type "%s"', [value]);
  end;
end;

function TRSFarmingTravel.BoxFromJSON(item: TJSONItem): TBox; static;
begin
  if (item.Typ <> EJSONType.ARR) or (item.Count <> 4) then
    raise 'Travel destination map must be [x1, y1, x2, y2]';

  Result := [
    item.Item[0].AsInt,
    item.Item[1].AsInt,
    item.Item[2].AsInt,
    item.Item[3].AsInt
  ];
end;

function TRSFarmingTravel.StringArrayFromJSON(item: TJSONItem): TStringArray; static;
var
  i: Integer;
begin
  if item.Typ <> EJSONType.ARR then
    raise 'Expected JSON array of strings';

  SetLength(Result, item.Count);
  for i := 0 to item.Count - 1 do
    Result[i] := item.Item[i].AsString;
end;

function TRSFarmingTravel.JSONHas(item: TJSONItem; key: String): Boolean; static;
begin
  try
    Result := item.Item[key].Typ <> EJSONType.UNKNOWN;
  except
    Result := False;
  end;
end;

function TRSFarmingTravel.ResolveDataPath(path: String): String;
var
  candidate: String;
  candidates: TStringArray;
begin
  if path <> '' then
  begin
    if not FileExists(path) then
      raise Format('Travel data file not found: %s', [path]);
    Exit(path);
  end;

  candidates := [
    IncludePath + 'data/travel.json',
    IncludePath + '../data/travel.json',
    './data/travel.json',
    'data/travel.json'
  ];

  for candidate in candidates do
    if FileExists(candidate) then
      Exit(candidate);

  raise 'travel.json not found. Pass an absolute path to FarmingTravel.Init()';
end;

function TRSFarmingTravel.HasDestination(destinationId: String): Boolean;
var
  destination: TRSFarmTravelDestination;
begin
  for destination in Self.Destinations do
    if destination.Id = destinationId then
      Exit(True);
end;

function TRSFarmingTravel.HasMethod(methodId: String): Boolean;
var
  method: TRSFarmTravelMethod;
begin
  for method in Self.Methods do
    if method.Id = methodId then
      Exit(True);
end;

function TRSFarmingTravel.FindDestination(destinationId: String): TRSFarmTravelDestination;
var
  destination: TRSFarmTravelDestination;
begin
  for destination in Self.Destinations do
    if destination.Id = destinationId then
      Exit(destination);

  raise Format('Unknown travel destination "%s"', [destinationId]);
end;

function TRSFarmingTravel.FindMethod(methodId: String): TRSFarmTravelMethod;
var
  method: TRSFarmTravelMethod;
begin
  for method in Self.Methods do
    if method.Id = methodId then
      Exit(method);

  raise Format('Unknown travel method "%s"', [methodId]);
end;

function TRSFarmingTravel.FindPatchRoute(patchId: String): TRSFarmTravelPatchRoute;
var
  route: TRSFarmTravelPatchRoute;
begin
  for route in Self.Patches do
    if route.PatchId = patchId then
      Exit(route);

  raise Format('No travel route configured for patch "%s"', [patchId]);
end;

function TRSFarmingTravel.SpellFromName(spellName: String): ERSSpell;
var
  spell: ERSSpell;
  needle: String;
begin
  needle := spellName.ToUpper().Replace(' ', '_');
  for spell in ERSSpell do
    if ToStr(spell).After('ERSSpell.') = needle then
      Exit(spell);

  raise Format('Unknown spell "%s" in travel.json', [spellName]);
end;

procedure TRSFarmingTravel.LoadMap(destinationId: String);
var
  destination: TRSFarmTravelDestination;
begin
  destination := Self.FindDestination(destinationId);
  Map.AddEx([RSTranslator.Global2Chunk(destination.MapArea.Expand(80))], [0]);
end;

function TRSFarmingTravel.Confirm(destinationId: String; timeout: Integer = 3000): Boolean;
var
  destination: TRSFarmTravelDestination;
begin
  destination := Self.FindDestination(destinationId);
  Result := SleepUntil(Map.Position in destination.MapArea, Random(100, 600), timeout);
end;

function TRSFarmingTravel.AlreadyThere(destinationId: String): Boolean;
var
  destination: TRSFarmTravelDestination;
begin
  destination := Self.FindDestination(destinationId);
  Result := destination.MapArea.Contains(Map.Position);
end;

function TRSFarmingTravel.ItemTeleport(method: TRSFarmTravelMethod; attempts: Integer): Boolean;
var
  itemInterface: TRSItemInterface;
  slotInterface: TRSSlotInterface;
  attempt, slot: Integer;

  function TryUse(items: TRSItemInterface; slots: TRSSlotInterface): Boolean;
  begin
    for attempt := 1 to attempts do
      if items.Find(method.Item, slot) then
      begin
        slots.Hover(slot);
        Sleep(75);
        if MainScreen.IsUpText(method.Option) then
        begin
          Mouse.Click(EMouseButton.LEFT);
          Exit(Self.Confirm(method.DestinationId));
        end else if ChooseOption.Open then
        begin
          if ChooseOption.Find([method.Option], False, False) then
            Exit(ChooseOption.Select(method.Option, False, True) and Self.Confirm(method.DestinationId))
          else if ChooseOption.OpenSubmenu(True) then
            Exit(ChooseOption.SelectSubmenuOption([method.Option], False, True) and Self.Confirm(method.DestinationId));
        end;
      end;
  end;

begin
  Self.LoadMap(method.DestinationId);
  if Self.AlreadyThere(method.DestinationId) then
    Exit(True);

  if Inventory.IsOpen then
  begin
    if TryUse(Inventory.Items, Inventory.Slots) then
      Exit(True);
  end else if Equipment.IsOpen then
  begin
    if TryUse(Equipment.Items, Equipment.Slots) then
      Exit(True);
  end else if Inventory.Open then
  begin
    if TryUse(Inventory.Items, Inventory.Slots) then
      Exit(True);
  end else if Equipment.Open then
  begin
    if TryUse(Equipment.Items, Equipment.Slots) then
      Exit(True);
  end else
    Exit;

  if Inventory.IsOpen and Equipment.Open then
    Exit(TryUse(Equipment.Items, Equipment.Slots));

  if Equipment.IsOpen and Inventory.Open then
    Exit(TryUse(Inventory.Items, Inventory.Slots));
end;

function TRSFarmingTravel.MagicTeleport(method: TRSFarmTravelMethod; attempts: Integer): Boolean;
var
  attempt: Integer;
  spell: ERSSpell;
  destination: TRSFarmTravelDestination;
begin
  Self.LoadMap(method.DestinationId);
  if Self.AlreadyThere(method.DestinationId) then
    Exit(True);

  spell := Self.SpellFromName(method.SpellName);
  destination := Self.FindDestination(method.DestinationId);

  for attempt := 1 to attempts do
  begin
    if (Magic.GetSpellBook = ERSSpellBook.LUNAR) and not (spell in RS_LUNAR_SPELLS) then
      if not (Magic.CastSpell(ERSSpell.SPELLBOOK_SWAP) and SleepUntil((Magic.GetSpellBook <> ERSSpellBook.LUNAR), Random(100, 800), 3000)) then
        Continue;

    if Magic.CastSpell(spell, method.Option) and SleepUntil(destination.MapArea.Contains(Map.Position), Random(100, 800), 2400) then
      Exit(True);
  end;
end;

function TRSFarmingTravel.POHPortal(method: TRSFarmTravelMethod; attempts: Integer): Boolean;
begin
  Result := False;
  raise Format('POH portal travel is not implemented yet (%s -> %s)', [method.Id, method.DestinationId]);
end;

function TRSFarmingTravel.POHNexus(method: TRSFarmTravelMethod; attempts: Integer): Boolean;
begin
  Result := False;
  raise Format('POH nexus travel is not implemented yet (%s -> %s)', [method.Id, method.DestinationId]);
end;

function TRSFarmingTravel.POHSpiritTree(method: TRSFarmTravelMethod; attempts: Integer): Boolean;
begin
  Result := False;
  raise Format('POH spirit tree travel is not implemented yet (%s -> %s)', [method.Id, method.DestinationId]);
end;

function TRSFarmingTravel.ConfirmOnly(method: TRSFarmTravelMethod; attempts: Integer): Boolean;
begin
  Self.LoadMap(method.DestinationId);
  Result := Self.Confirm(method.DestinationId);
end;

function TRSFarmingTravel.Travel(methodId: String; attempts: Integer = 2): Boolean;
var
  method: TRSFarmTravelMethod;
begin
  if not Self.Loaded then
    raise 'FarmingTravel.Init() must be called before Travel()';

  method := Self.FindMethod(methodId);
  WriteLn(Format('%s:[FarmingTravel]: method=%s type=%s destination=%s', [
    GetTimeStamp(),
    method.Id,
    ToStr(method.TravelType),
    method.DestinationId
  ]));

  case method.TravelType of
    ERSFarmTravelType.ITEM:            Exit(Self.ItemTeleport(method, attempts));
    ERSFarmTravelType.MAGIC:           Exit(Self.MagicTeleport(method, attempts));
    ERSFarmTravelType.POH_PORTAL:      Exit(Self.POHPortal(method, attempts));
    ERSFarmTravelType.POH_NEXUS:       Exit(Self.POHNexus(method, attempts));
    ERSFarmTravelType.POH_SPIRIT_TREE: Exit(Self.POHSpiritTree(method, attempts));
    ERSFarmTravelType.CONFIRM:         Exit(Self.ConfirmOnly(method, attempts));
  end;
end;

function TRSFarmingTravel.TravelToPatch(patchId: String; preferredMethod: String = ''; attempts: Integer = 2): Boolean;
var
  route: TRSFarmTravelPatchRoute;
  methodId: String;
begin
  route := Self.FindPatchRoute(patchId);

  if preferredMethod <> '' then
  begin
    if not route.MethodIds.Contains(preferredMethod) then
      raise Format('Method "%s" is not allowed for patch "%s"', [preferredMethod, patchId]);
    Exit(Self.Travel(preferredMethod, attempts));
  end;

  for methodId in route.MethodIds do
    if Self.Travel(methodId, attempts) then
      Exit(True);
end;

procedure TRSFarmingTravel.ParseDestinations(root: TJSONItem);
var
  destinations: TJSONItem;
  node: TJSONItem;
  i: Integer;
  destination: TRSFarmTravelDestination;
begin
  destinations := root.Item['destinations'];
  if destinations.Typ <> EJSONType.ARR then
    raise 'travel.json destinations must be an array';

  SetLength(Self.Destinations, destinations.Count);
  for i := 0 to destinations.Count - 1 do
  begin
    node := destinations.Item[i];
    destination.Id := node.Item['id'].AsString;
    destination.MapArea := Self.BoxFromJSON(node.Item['map']);
    Self.Destinations[i] := destination;
  end;
end;

procedure TRSFarmingTravel.ParseMethods(root: TJSONItem);
var
  methods: TJSONItem;
  node: TJSONItem;
  i: Integer;
  method: TRSFarmTravelMethod;
begin
  methods := root.Item['methods'];
  if methods.Typ <> EJSONType.ARR then
    raise 'travel.json methods must be an array';

  SetLength(Self.Methods, methods.Count);
  for i := 0 to methods.Count - 1 do
  begin
    node := methods.Item[i];
    method.Id := node.Item['id'].AsString;
    method.TravelType := ERSFarmTravelType.FromString(node.Item['type'].AsString);
    method.DestinationId := node.Item['destination'].AsString;
    method.Item := '';
    method.Option := '';
    method.SpellName := '';

    if Self.JSONHas(node, 'item') then
      method.Item := node.Item['item'].AsString;
    if Self.JSONHas(node, 'option') then
      method.Option := node.Item['option'].AsString;
    if Self.JSONHas(node, 'spell') then
      method.SpellName := node.Item['spell'].AsString;

    case method.TravelType of
      ERSFarmTravelType.ITEM:
        if (method.Item = '') or (method.Option = '') then
          raise Format('Method "%s" requires item + option', [method.Id]);
      ERSFarmTravelType.MAGIC:
        if method.SpellName = '' then
          raise Format('Method "%s" requires spell', [method.Id]);
    end;

    if not Self.HasDestination(method.DestinationId) then
      raise Format('Method "%s" references unknown destination "%s"', [method.Id, method.DestinationId]);

    Self.Methods[i] := method;
  end;
end;

procedure TRSFarmingTravel.ParsePatches(root: TJSONItem);
var
  patches: TJSONItem;
  node: TJSONItem;
  i: Integer;
  route: TRSFarmTravelPatchRoute;
  methodId: String;
begin
  patches := root.Item['patches'];
  if patches.Typ <> EJSONType.ARR then
    raise 'travel.json patches must be an array';

  SetLength(Self.Patches, patches.Count);
  for i := 0 to patches.Count - 1 do
  begin
    node := patches.Item[i];
    route.PatchId := node.Item['id'].AsString;
    route.DestinationId := node.Item['destination'].AsString;
    route.MethodIds := Self.StringArrayFromJSON(node.Item['methods']);

    if not Self.HasDestination(route.DestinationId) then
      raise Format('Patch "%s" references unknown destination "%s"', [route.PatchId, route.DestinationId]);

    for methodId in route.MethodIds do
      if not Self.HasMethod(methodId) then
        raise Format('Patch "%s" references unknown method "%s"', [route.PatchId, methodId]);

    Self.Patches[i] := route;
  end;
end;

procedure TRSFarmingTravel.Load(path: String = '');
var
  parser: TJSONParser;
begin
  Self.DataPath := Self.ResolveDataPath(path);
  parser := new TJSONParser();
  parser.Load(Self.DataPath);

  Self.ParseDestinations(parser);
  Self.ParseMethods(parser);
  Self.ParsePatches(parser);
  Self.Loaded := True;

  WriteLn(Format('%s:[FarmingTravel]: loaded %s (%d destinations, %d methods, %d patches)', [
    GetTimeStamp(),
    Self.DataPath,
    Length(Self.Destinations),
    Length(Self.Methods),
    Length(Self.Patches)
  ]));
end;

procedure TRSFarmingTravel.Init(path: String = '');
begin
  Self.Load(path);
end;

function TRSFarmingTravel.MethodIds(): TStringArray;
var
  method: TRSFarmTravelMethod;
begin
  for method in Self.Methods do
    Result += method.Id;
end;

function TRSFarmingTravel.PatchIds(): TStringArray;
var
  route: TRSFarmTravelPatchRoute;
begin
  for route in Self.Patches do
    Result += route.PatchId;
end;
