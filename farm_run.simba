{$INCLUDE_ONCE WaspLib/osrs.simba}
{$INCLUDE_ONCE patch.simba}

type
  TRSFarmRun = record
    Patches: array of TRSFarmPatch;
    EquipmentLoadout: TRSBankItemArray;
    InventoryLoadout: TRSBankItemArray;
    Interval: Integer;
    IntervalTimer: TCountDown;

    ScriptReturn: procedure(); of object;
  end;

function TRSBank.Withdraw(items: TRSBankItemArray; useQuantityButton: Boolean; useCache: Boolean): Boolean;
var
  item: TRSBankItem;
  attempt: Integer;
  ok: Boolean;
begin
  for item in items do
  begin
    ok := False;
    for attempt := 1 to 2 do
      if Bank.Withdraw(item, useQuantityButton, useCache) then
      begin
        ok := True;
        Break;
      end;

    if not ok then
      Exit;
  end;

  for item in items do
    if item.Quantity > 1 then
    begin
      if not SleepUntil(Inventory.Items.Count(item.Item) >= item.Quantity, Random(100, 150), 600) then
        Exit;
    end
    else if not SleepUntil(Inventory.Items.Contains(item.Item), Random(100, 150), 600) then
      Exit;

  Result := True;
end;

function TRSFarmRun.WithdrawFarmingInventory(): Boolean;
begin
  if Length(Self.InventoryLoadout) = 0 then
    Exit(True);

  if not Bank.Open() then
    Exit;

  Result := Bank.Withdraw(Self.InventoryLoadout, True, True);
end;

function TRSFarmRun.Run(): Boolean;
var
  i: Integer;
begin
  if not Self.WithdrawFarmingInventory() then
    Exit;

  for i := 0 to High(Self.Patches) do
  begin
    Self.Patches[i].Reset();
    if not Self.Patches[i].Run() then
      WriteLn(Format('%s:[TRSFarmRun]: Patch %s did not complete cleanly', [
        GetTimeStamp(),
        Self.Patches[i].Descriptor.ToString()
      ]));
  end;

  if Self.Interval > 0 then
    Self.IntervalTimer.Start(Self.Interval);

  Result := True;
end;
